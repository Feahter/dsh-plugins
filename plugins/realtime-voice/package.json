{
  "name": "dsh-realtime-voice",
  "description": "Continuous realtime dictation for the composer, powered by the local SenseVoice recognizer",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "host/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "docs/INTEGRATION.md",
    "test/harness.mjs",
    "test/host-refine.test.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "test": "node test/harness.mjs && node --test test/host-refine.test.mjs",
    "test:client": "node test/harness.mjs",
    "test:host": "node --test test/host-refine.test.mjs"
  }
}
